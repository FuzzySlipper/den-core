{
  "DenCore": {
    "Provider": "Sqlite",
    "DatabasePath": "",
    "ConnectionString": "",
    "ListenUrl": "http://localhost:5199",
    "BlockedTaskEscalation": {
      "DedupWindow": "01:00:00"
    },
    "Llm": {
      "Endpoint": "",
      "ApiKey": "",
      "Model": "",
      "MaxTokens": 4096,
      "ContextTokenBudget": 8000
    },
    "TrustedPublisher": {
      "AllowedOrchestrators": [
        "den-mcp-runner",
        "den-channels-runner",
        "den-gateway-runner",
        "den-hermes-runner",
        "den-desktop-runner"
      ],
      "AllowedTargetBranches": [
        "main"
      ],
      "ProjectRootSearchPaths": [
        "/data/services/den-core/git",
        "/home/dev",
        "/data/dev",
        "/mnt/den-srv/dev"
      ],
      "ReviewedArtifactSearchPaths": [
        "/data/services/den-core/reviewed-artifacts"
      ]
    },
    "DenPublishFacade": {
      "Endpoint": "http://127.0.0.1:5090",
      "TrustedOrchestrators": [
        "den-mcp-runner",
        "den-channels-runner",
        "den-gateway-runner",
        "den-hermes-runner",
        "den-desktop-runner"
      ],
      "TrustedOrchestratorRoles": [
        "orchestrator"
      ],
      "TrustedOrchestratorPolicyMode": "audit_warn"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

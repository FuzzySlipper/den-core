<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <!-- Build frontend during non-Release dev builds when node_modules exists. PublishClientApp handles Release publish and installs dev dependencies before building. -->
  <Target Name="BuildClientApp" BeforeTargets="Build" Condition="'$(Configuration)' != 'Release' And Exists('ClientApp/node_modules')">
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

  <!-- Always build frontend on publish -->
  <Target Name="PublishClientApp" BeforeTargets="Publish">
    <Exec Command="npm ci --include=dev &amp;&amp; npm run build" WorkingDirectory="ClientApp" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\DenMcp.Core\DenMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

</Project>
